ALPACA_API_KEY=
ALPACA_SECRET_KEY=
GROQ_API_KEY=
REDIS_URL=redis://localhost:6379
FRONTEND_ORIGIN=http://localhost:3000

# Single-user login (see backend/auth.py). AUTH_USERNAME/AUTH_PASSWORD
# are only used once, to seed the account into Redis on first startup —
# changing them later has no effect unless you also clear the
# auth:username / auth:password_hash keys in Redis.
AUTH_SECRET_KEY=
AUTH_USERNAME=
AUTH_PASSWORD=

# Web Push (see backend/push_service.py). Generate a key pair once with:
#   python3 -c "from py_vapid import Vapid02; import base64; v = Vapid02(); v.generate_keys(); \
#     pn = v.private_key.private_numbers(); \
#     print('VAPID_PRIVATE_KEY=' + base64.urlsafe_b64encode(pn.private_value.to_bytes(32, 'big')).decode().rstrip('=')); \
#     from cryptography.hazmat.primitives import serialization; \
#     pub = v.public_key.public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint); \
#     print('VAPID_PUBLIC_KEY=' + base64.urlsafe_b64encode(pub).decode().rstrip('='))"
# VAPID_PUBLIC_KEY also needs to be set as the frontend's
# NEXT_PUBLIC_VAPID_PUBLIC_KEY (frontend/.env.local) — same value, both
# places. If unset, push notifications and the daily digest silently
# no-op rather than crash the app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=
# UTC hour (0-23) the daily digest push fires. Defaults to 0 (07:00 WIB).
DIGEST_HOUR_UTC=0
