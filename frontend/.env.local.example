NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_API_URL=http://localhost:8000
# Same value as the backend's VAPID_PUBLIC_KEY (see backend/.env.example)
# — the public half of one key pair, needed in both places. Push
# notifications are silently disabled if this is unset.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
